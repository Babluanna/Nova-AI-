# GEMINI_API_KEY: Required for server-side Google Gemini chat, multimodal, and image generation API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Configure or upgrade via Settings > Secrets in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Required for OpenRouter chat and image generation completions.
# Add OPENROUTER_API_KEY via Settings > Secrets in Google AI Studio. Never expose to client code.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OpenRouter HTTP-Referer headers, and API endpoints.
APP_URL="MY_APP_URL"
